[Unit]
Description=gameWE - collector (game server statistics)
Documentation=file:///opt/gamewe/collector/doc/README.md
Wants=network-online.target
After=network-online.target mariadb.service mysql.service

[Service]
# notify: gamewe tells systemd "ready" only once the config, the database
# (and its migration) and the UDP port are fine, so "systemctl start" and
# "restart" wait for that and fail visibly when the collector cannot start.
Type=notify
NotifyAccess=main
User=gamewe
Group=gamewe
# The inputs for game-server logs are listen: in the config (UDP, default
# 0.0.0.0:41337; HTTP for Counter-Strike 2, default off, TCP 41338). Game
# servers and settings come from the database and are re-read every minute.
ExecStart=/opt/gamewe/collector/bin/gamewe run -config /etc/gamewe/collector/config.yaml
Restart=on-failure
RestartSec=5s
# Exit code 78: the config (or a schema that is not migrated automatically)
# needs an admin; restarting does not help, the unit stays failed. 2: wrong
# command line. Other failures (database not reachable yet) are retried.
RestartPreventExitStatus=2 78
# The start includes the database connection; a long automatic migration
# extends this itself while it runs.
TimeoutStartSec=2min

# Hardening. The collector only needs to read /etc/gamewe and talk to the
# network (UDP logs in, database and RCON out).
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/etc/gamewe/collector
# /var/lib/gamewe/collector (writable, owned by gamewe): the GeoIP database
# and its monthly update.
StateDirectory=gamewe/collector
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
