[Unit]
Description=gameWE - collector (game server statistics)
Documentation=file:///opt/gamewe/collector/doc/README.md
Wants=network-online.target
After=network-online.target mariadb.service mysql.service

[Service]
Type=simple
User=gamewe
Group=gamewe
# The UDP address for game-server logs is listen: in the config (default
# 0.0.0.0:41337). Game servers and settings come from the database and are
# re-read every minute.
ExecStart=/opt/gamewe/collector/bin/gamewe run -config /etc/gamewe/collector/config.yaml
Restart=on-failure
RestartSec=5s

# Hardening. The collector only needs to read /etc/gamewe and talk to the
# network (UDP logs in, database and RCON out).
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/etc/gamewe/collector
# /var/lib/gamewe/collector (writable, owned by gamewe): the GeoIP database
# and its monthly update.
StateDirectory=gamewe/collector
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
